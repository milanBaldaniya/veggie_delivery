NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# This server's own public URL (no trailing slash). Used to build absolute
# links such as the APK download URL embedded in the admin panel's QR code.
# Defaults to http://localhost:$PORT if unset — set this to the real deployed
# URL in production (e.g. https://veggie-delivery-rs0y.onrender.com).
PUBLIC_URL=http://localhost:5000

MONGO_URI=mongodb://127.0.0.1:27017/veggie_delivery

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Timezone the delivery window / order cutoff is evaluated in. The delivery
# window and cutoff time themselves are admin-configurable (Delivery Settings
# in the admin panel), not env vars.
ORDER_TIMEZONE=Asia/Kolkata

# Weekly bill finalization schedule (cron, runs in ORDER_TIMEZONE).
# Default: Monday 00:05 — closes out the week that just ended.
WEEKLY_BILLING_CRON=5 0 * * 1

# Google Sign-In (via Firebase Auth) — path to the Firebase Admin SDK service
# account JSON used to verify the Firebase ID tokens the mobile app sends.
# Firebase Console → Project Settings → Service Accounts → Generate new private
# key. Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

CORS_ORIGIN=*

# Cloudinary (product image uploads) — get these from your Cloudinary dashboard.
# Uploads are disabled until all three are set.
CLOUDINARY_CLOUD_NAME=ovor39bp
CLOUDINARY_API_KEY=355932848114237
CLOUDINARY_API_SECRET=TUS3V4zTIPVPR2VLM2hQRgh62pY
# Folder images are stored under in Cloudinary.
CLOUDINARY_FOLDER=veggie-delivery/products

# Default Super Admin — auto-seeded on every server boot (see
# src/seeders/seedSuperAdmin.js). Optional; falls back to the values below.
SEED_ADMIN_EMAIL=admin@veggie.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Super Admin
